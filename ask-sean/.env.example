# DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional overrides
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# The live iherng Journal site, used to build each article's stable URL
JOURNAL_SITE_URL=https://iherng-journal.pages.dev
# Optional: the Journal checkout scripts/auto-journal.ts writes to. Defaults to the
# repository this folder is in, so it is only needed for an unusual layout.
# JOURNAL_DIR=..
