{
  "name": "asking-iherng",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "kb:sync": "tsx scripts/sync.ts",
    "kb:enrich": "tsx scripts/enrich.ts",
    "kb:build": "tsx scripts/build.ts",
    "kb": "npm run kb:sync && npm run kb:enrich && npm run kb:build",
    "ask": "tsx scripts/ask.ts",
    "auto:journal": "tsx scripts/auto-journal.ts",
    "eval:route": "tsx scripts/eval-route.ts",
    "eval:answers": "tsx scripts/eval-answers.ts",
    "db:migrate:local": "wrangler d1 migrations apply ask-sean --local --config wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply ask-sean --remote --config wrangler.toml",
    "worker:dev": "wrangler dev --config wrangler.toml",
    "worker:deploy": "wrangler deploy --config wrangler.toml",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
